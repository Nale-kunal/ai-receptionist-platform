# ── DENTAL AI RECEPTIONIST SAAS — BACKEND ENVIRONMENT TEMPLATE ──────────────

NODE_ENV=production
PORT=3000
CORS_ORIGIN=*

# Database connection URLs (Neon PostgreSQL)
# Runtime application connection uses Neon Connection Pooler
DATABASE_URL=postgresql://[DB_USER]:[DB_PASSWORD]@[NEON_HOST]-pooler.c-11.us-east-1.aws.neon.tech/[DB_NAME]?sslmode=require&connect_timeout=15&pool_timeout=15&connection_limit=10
# Direct connection for Prisma CLI migrations & administrative tasks
DIRECT_URL=postgresql://[DB_USER]:[DB_PASSWORD]@[NEON_HOST].c-11.us-east-1.aws.neon.tech/[DB_NAME]?sslmode=require&connect_timeout=15

# Cryptographically strong secrets (Must be at least 32 chars)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
CALENDAR_ENCRYPTION_SECRET=

# OpenAI API Key (Must start with sk- in production)
OPENAI_API_KEY=

# ── Email Infrastructure (Default: Resend) ─────────────────────────────────
EMAIL_PROVIDER=resend
EMAIL_FROM_NAME="Dental AI"
# Production MUST use a verified custom domain email (e.g. no-reply@yourdomain.com).
# onboarding@resend.dev is strictly rejected in production mode.
EMAIL_FROM_EMAIL="no-reply@yourdomain.com"
RESEND_API_KEY=re_1234567890abcdef

# Application Branding & URLs
APP_NAME="Dental AI Receptionist"
APP_URL=https://app.yourdomain.com
FRONTEND_URL=https://app.yourdomain.com
BACKEND_URL=https://api.yourdomain.com

# Optional Failover Providers
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SENDGRID_API_KEY=
# POSTMARK_SERVER_TOKEN=

# ── WhatsApp Cloud API (Meta) ──────────────────────────────────────────────
# Meta System User Permanent Access Token with whatsapp_business_messaging & management permissions
WHATSAPP_ACCESS_TOKEN=
# Meta App Secret for X-Hub-Signature-256 HMAC verification
WHATSAPP_APP_SECRET=
# Platform Webhook GET verification handshake secret (configured in Meta App Dashboard)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Meta Graph API Version
WHATSAPP_API_VERSION=v21.0

