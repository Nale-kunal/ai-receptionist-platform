// ---------------------------------------------------------------------------
// WhatsApp Integration — per-clinic WhatsApp Business configuration
// One phone number maps to exactly one clinic/tenant (enforced by UNIQUE constraint)
// ---------------------------------------------------------------------------

model WhatsAppIntegration {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  publicId         String    @unique @default(dbgenerated("'wa_' || substr(md5(random()::text), 1, 12)")) @map("public_id")
  tenantId         String    @map("tenant_id") @db.Uuid
  clinicId         String    @map("clinic_id") @db.Uuid

  // Meta phone number identity
  phoneNumber      String    @unique @map("phone_number")  // E.164, e.g. +14155552671 — UNIQUE enforces 1 clinic per number
  phoneNumberId    String    @map("phone_number_id")       // Meta phone number ID
  wabaId           String    @map("waba_id")               // WhatsApp Business Account ID
  displayName      String    @map("display_name")

  // Lifecycle
  status           String    @default("inactive")  // 'active' | 'inactive' | 'suspended'
  isEnabled        Boolean   @default(false) @map("is_enabled")

  // Webhook verification token (plaintext — used only for Meta GET handshake, not a security secret)
  webhookVerifyToken String  @map("webhook_verify_token")

  // Bot / AI configuration for this number
  // Stored as JSON: { greeting, personality, bookingEnabled, rescheduleEnabled, cancelEnabled,
  //                  allowedAppointmentTypes, bookingHorizonDays, minNoticePeriodHours,
  //                  handoffKeywords, handoffEnabled, emergencyPhone }
  settings         Json      @default("{}") @map("settings")

  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt      @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  tenant           Tenant    @relation(fields: [tenantId], references: [id])
  clinic           Clinic    @relation(fields: [clinicId], references: [id])
  jobs             WhatsAppJob[]
  messages         WhatsAppMessage[]

  @@index([tenantId])
  @@index([clinicId])
  @@index([tenantId, clinicId])
  @@index([phoneNumber])
  @@index([status])
  @@index([isEnabled])
  @@map("whatsapp_integrations")
}

// ---------------------------------------------------------------------------
// WhatsApp Job — Durable, Crash-Safe Processing Queue
//
// Follows the identical pattern as MailJob:
//   1. idempotencyKey UNIQUE — duplicate enqueue is a no-op
//   2. Atomic lease claiming via FOR UPDATE SKIP LOCKED
//   3. Terminal status guard — processed records are never re-queued
//
// Job Types:
//   process_inbound — process a received patient message through AI pipeline
//   send_outbound   — deliver an AI-generated reply to the patient
// ---------------------------------------------------------------------------

model WhatsAppJob {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // Idempotency key — prevents duplicate enqueue across restarts/concurrent workers
  idempotencyKey   String    @unique @map("idempotency_key")

  tenantId         String    @map("tenant_id") @db.Uuid
  clinicId         String    @map("clinic_id") @db.Uuid
  integrationId    String    @map("integration_id") @db.Uuid
  conversationId   String?   @map("conversation_id") @db.Uuid

  jobType          String    @map("job_type")  // 'process_inbound' | 'send_outbound'

  // State machine: queued → processing → processed (terminal)
  //                queued → processing → failed_retryable → queued (retry)
  //                queued → processing → failed_permanent (terminal)
  status           String    @default("queued") // queued | processing | processed | failed_retryable | failed_permanent

  // Provider-normalized message/event payload
  payload          Json

  // Meta message ID for deduplication
  providerMessageId String?  @map("provider_message_id")

  attempts         Int       @default(0)
  maxAttempts      Int       @default(3) @map("max_attempts")

  // Lease-based atomic claiming
  workerId         String?   @map("worker_id")
  leaseId          String?   @map("lease_id")
  leaseExpiresAt   DateTime? @map("lease_expires_at")

  nextAttemptAt    DateTime? @map("next_attempt_at")
  lastAttemptAt    DateTime? @map("last_attempt_at")
  processedAt      DateTime? @map("processed_at")
  failedAt         DateTime? @map("failed_at")
  failureReason    String?   @map("failure_reason")
  correlationId    String?   @map("correlation_id")

  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt      @map("updated_at")

  tenant           Tenant              @relation(fields: [tenantId], references: [id])
  clinic           Clinic              @relation(fields: [clinicId], references: [id])
  integration      WhatsAppIntegration @relation(fields: [integrationId], references: [id])

  // Worker poll index: queued jobs ready to claim
  @@index([status, nextAttemptAt, createdAt])
  // Stale lease recovery
  @@index([status, leaseExpiresAt])
  @@index([tenantId, status])
  @@index([providerMessageId])
  @@index([correlationId])
  @@map("whatsapp_jobs")
}

// ---------------------------------------------------------------------------
// WhatsApp Message — Inbound and outbound message log
// providerMessageId (wamid) is UNIQUE for deduplication
// ---------------------------------------------------------------------------

model WhatsAppMessage {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  clinicId          String    @map("clinic_id") @db.Uuid
  integrationId     String    @map("integration_id") @db.Uuid
  conversationId    String?   @map("conversation_id") @db.Uuid

  // Meta wamid — UNIQUE constraint enforces idempotent message storage
  providerMessageId String    @unique @map("provider_message_id")

  direction         String    // 'inbound' | 'outbound'
  fromNumber        String    @map("from_number")  // E.164
  toNumber          String    @map("to_number")    // E.164
  messageType       String    @map("message_type") // 'text' | 'interactive' | 'template' | 'image' | 'audio' | 'document'
  content           Json      // normalized content { text?: string, ... }

  // Provider delivery status
  status            String    @default("received") // received | sent | delivered | read | failed
  providerStatus    String?   @map("provider_status")  // raw Meta status

  // Processing state
  processingStatus  String    @default("pending") @map("processing_status") // pending | processed | skipped | error

  metadata          Json      @default("{}") @map("metadata")

  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt      @map("updated_at")

  tenant            Tenant              @relation(fields: [tenantId], references: [id])
  clinic            Clinic              @relation(fields: [clinicId], references: [id])
  integration       WhatsAppIntegration @relation(fields: [integrationId], references: [id])

  @@index([tenantId])
  @@index([clinicId])
  @@index([integrationId])
  @@index([conversationId])
  @@index([direction])
  @@index([fromNumber])
  @@index([status])
  @@index([processingStatus])
  @@index([createdAt])
  @@map("whatsapp_messages")
}

// ---------------------------------------------------------------------------
// WhatsApp Webhook Event — Raw event audit log (immutable)
// Stored for audit, replay, and debugging. Never used for business logic.
// ---------------------------------------------------------------------------

model WhatsAppWebhookEvent {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  providerEventId   String?   @map("provider_event_id")  // Meta event ID if available
  tenantId          String?   @map("tenant_id") @db.Uuid  // resolved after validation; null if unresolvable
  destinationPhone  String?   @map("destination_phone")  // 'to' phone from payload
  rawPayload        Json      @map("raw_payload")         // full raw body, stored as-is
  signatureHeader   String?   @map("signature_header")   // X-Hub-Signature-256 value
  processingStatus  String    @default("received") @map("processing_status") // received | queued | processed | quarantined | error
  errorDetails      String?   @map("error_details") @db.Text
  correlationId     String?   @map("correlation_id")
  createdAt         DateTime  @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([destinationPhone])
  @@index([processingStatus])
  @@index([createdAt])
  @@index([correlationId])
  @@map("whatsapp_webhook_events")
}
