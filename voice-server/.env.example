# ── DENTAL AI RECEPTIONIST SAAS — VOICE SERVER ENVIRONMENT TEMPLATE ─────────

NODE_ENV=production
PORT=5000

# Twilio Credentials
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Media stream connection url (Twilio will push stream packets to this wss url)
TWILIO_MEDIA_STREAM_URL=

# Twilio Webhook callback url
TWILIO_WEBHOOK_URL=

# Stream Settings (defaults are safe, tune if needed)
TWILIO_SAMPLE_RATE=8000
TWILIO_CODEC=audio/PCMU
TWILIO_MAX_CALL_DURATION=3600
TWILIO_HEARTBEAT_INTERVAL=10000
TWILIO_RECONNECT_ATTEMPTS=5
TWILIO_SILENCE_THRESHOLD_DB=-45
TWILIO_SILENCE_DURATION_MS=2000
